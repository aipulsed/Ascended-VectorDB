/**
 * Prisma schema for @ascendstack/vectordb.
 * Defines all database models for the AscendStack vector database,
 * including multi-tenant tables, workflow execution state, vector embeddings,
 * agent memory, and document storage with pgvector support.
 */

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  RETRYING
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Tenant model – root entity for multi-tenancy.
model Tenant {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  plan       String   @default("free")
  isActive   Boolean  @default(true)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("Tenant")
}

/// Workflow definition stored as JSON, versioned per tenant.
model Workflow {
  id          String          @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  definition  Json
  status      WorkflowStatus  @default(DRAFT)
  version     Int             @default(1)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  executions Execution[]

  @@map("Workflow")
}

/// Execution represents a single run of a workflow or standalone job.
model Execution {
  id           String          @id @default(uuid())
  tenant_id    String
  workflow_id  String?
  status       ExecutionStatus @default(PENDING)
  input        Json?
  output       Json?
  error        String?
  started_at   DateTime?
  completed_at DateTime?
  retries      Int             @default(0)
  max_retries  Int             @default(3)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  workflow Workflow? @relation(fields: [workflow_id], references: [id])
  tasks    Task[]
  events   Event[]

  @@index([tenant_id, status])
  @@index([workflow_id])
  @@index([tenant_id, created_at])
  @@map("Execution")
}

/// Task represents a single step within an execution.
model Task {
  id           String     @id @default(uuid())
  tenant_id    String
  execution_id String
  step_name    String
  type         String
  status       TaskStatus @default(PENDING)
  input        Json?
  output       Json?
  error        String?
  retries      Int        @default(0)
  started_at   DateTime?
  completed_at DateTime?
  duration_ms  Int?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  execution Execution @relation(fields: [execution_id], references: [id])

  @@index([execution_id])
  @@index([tenant_id, status])
  @@map("Task")
}

/// Event captures domain events emitted by workflow executions and the event bus.
model Event {
  id             String   @id @default(uuid())
  tenant_id      String
  type           String
  payload        Json
  execution_id   String?
  source         String?
  correlation_id String?
  timestamp      DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  execution Execution? @relation(fields: [execution_id], references: [id])

  @@index([tenant_id, type])
  @@index([execution_id])
  @@index([tenant_id, timestamp])
  @@map("Event")
}

/// Document represents an ingested file or content blob.
model Document {
  id           String         @id @default(uuid())
  tenant_id    String
  filename     String
  content_type String
  size_bytes   Int?
  status       DocumentStatus @default(PENDING)
  storage_url  String?
  metadata     Json?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  deleted_at   DateTime?

  chunks DocumentChunk[]

  @@index([tenant_id, status])
  @@map("Document")
}

/// DocumentChunk is a text chunk derived from a Document for embedding.
model DocumentChunk {
  id          String   @id @default(uuid())
  tenant_id   String
  document_id String
  content     String
  chunk_index Int
  token_count Int?
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  document  Document   @relation(fields: [document_id], references: [id])
  embedding Embedding?

  @@index([document_id])
  @@index([tenant_id])
  @@map("DocumentChunk")
}

/// Embedding stores the pgvector embedding for a DocumentChunk or AgentMemory.
model Embedding {
  id                String                      @id @default(uuid())
  tenant_id         String
  document_chunk_id String?                     @unique
  agent_memory_id   String?                     @unique
  model             String                      @default("text-embedding-3-small")
  dimensions        Int                         @default(1536)
  embedding         Unsupported("vector(1536)")?
  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @updatedAt

  document_chunk DocumentChunk? @relation(fields: [document_chunk_id], references: [id])
  agent_memory   AgentMemory?   @relation(fields: [agent_memory_id], references: [id])

  @@index([tenant_id])
  @@index([document_chunk_id])
  @@map("Embedding")
}

/// AgentMemory stores key/value memory entries for AI agents with optional vector search.
model AgentMemory {
  id          String     @id @default(uuid())
  tenant_id   String
  agent_id    String
  key         String
  value       String
  memory_type MemoryType @default(SHORT_TERM)
  expires_at  DateTime?
  metadata    Json?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  embedding Embedding?

  @@unique([tenant_id, agent_id, key])
  @@index([tenant_id, agent_id])
  @@index([memory_type])
  @@map("AgentMemory")
}

/// ApiKey stores hashed API keys for tenant authentication.
model ApiKey {
  id           String    @id @default(uuid())
  tenant_id    String
  name         String
  key_hash     String    @unique
  last_used_at DateTime?
  expires_at   DateTime?
  is_active    Boolean   @default(true)
  scopes       String[]  @default([])
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([tenant_id])
  @@map("ApiKey")
}
